# ── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brand_store"

# ── Site ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Admin (đổi trước khi deploy) ───────────────────────────
ADMIN_PASSWORD="change-me"
# Chuỗi ngẫu nhiên dài ≥ 32 ký tự, dùng để ký cookie đăng nhập admin
ADMIN_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# ── Chuyển khoản ngân hàng (VietQR) ────────────────────────
# Mã BIN ngân hàng, ví dụ Vietcombank = 970436, Techcombank = 970407
BANK_BIN=""
BANK_ACCOUNT_NO=""
BANK_ACCOUNT_NAME=""

# ── VNPay (bỏ trống để ẩn phương thức VNPay) ───────────────
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
