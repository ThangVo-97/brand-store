{
  "name": "brand-store",
  "version": "1.0.0",
  "private": true,
  "description": "Starter kit cho website bán hàng cao cấp: Next.js, Tailwind, 3D, Prisma, PostgreSQL",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
